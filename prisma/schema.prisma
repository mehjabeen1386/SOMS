datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Child {
  id          String   @id @default(cuid())
  name        String
  age         Int
  gender      String
  admission   DateTime @default(now())
  healthStatus String  @default("Healthy")
  education   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Donor {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  amount      Float
  date        DateTime @default(now())
}

model Inventory {
  id          String   @id @default(cuid())
  itemName    String
  category    String
  quantity    Int
  unit        String
}